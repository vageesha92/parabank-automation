<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="UI Suite" data-provider-thread-count="1">

  <!-- registered here so it runs before Allure's listener closes the test in the report -->
  <listeners>
    <listener class-name="io.github.vageesha92.core.FailureListener"/>
  </listeners>

  <!-- the same UI tests run once per browser; the "browser" parameter selects it -->
  <test name="UI Chrome" parallel="methods" thread-count="2">
    <parameter name="browser" value="chrome"></parameter>
    <packages>
      <package name="io.github.vageesha92.ui"/>
    </packages>
  </test>

  <test name="UI Firefox" parallel="methods" thread-count="1">
    <parameter name="browser" value="firefox"></parameter>
    <packages>
      <package name="io.github.vageesha92.ui"/>
    </packages>
  </test>

</suite>
