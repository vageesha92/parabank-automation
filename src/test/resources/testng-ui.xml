<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="UI Suite" data-provider-thread-count="2">

  <!-- registered here so it runs before Allure's listener closes the test in the report -->
  <listeners>
    <listener class-name="io.github.vageesha92.core.FailureListener"/>
  </listeners>

  <test name="UI Tests" parallel="methods" thread-count="2">
    <packages>
      <package name="io.github.vageesha92.ui"/>
    </packages>
  </test>

</suite>
